# Copy to .env and fill in. Never commit .env.
CENSUS_API_KEY=            # free: https://api.census.gov/data/key_signup.html
AWS_REGION=us-east-1
DATA_BUCKET=citysim-data-<account-id>
BEDROCK_RESIDENT_MODEL=amazon.nova-2-lite-v1:0   # check exact id in the Bedrock console
BEDROCK_AGENT_MODEL=                              # stronger model for the chat agent
PERSONA_SEED=1114
