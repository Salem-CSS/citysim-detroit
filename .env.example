# Copy to .env and fill in. Never commit .env.
CENSUS_API_KEY=            # required (the API refuses keyless requests). Free: https://api.census.gov/data/key_signup.html
AWS_REGION=us-east-1
DATA_BUCKET=citysim-data-<account-id>
BEDROCK_RESIDENT_MODEL=us.anthropic.claude-haiku-5-5   # comparison model: us.amazon.nova-2-lite-v1:0
BEDROCK_AGENT_MODEL=                              # stronger model for the chat agent
PERSONA_SEED=1114
