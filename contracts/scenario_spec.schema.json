{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario_spec.schema.json",
  "title": "Scenario spec (v2)",
  "description": "The standard format a typed question is broken into. Each action carries its constraints; each constraint is one editable block in the left panel. Residents see only `summary` plus their own computed impact, never the raw prompt.",
  "type": "object",
  "required": [
    "spec_id",
    "version",
    "status",
    "prompt",
    "summary",
    "districts",
    "confidence",
    "actions"
  ],
  "properties": {
    "spec_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bumps every time the user edits blocks and asks again."
    },
    "parent_spec_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Previous version, for compare."
    },
    "status": {
      "enum": [
        "draft",
        "confirmed"
      ],
      "description": "draft: shown in the panel for review. confirmed: the user pressed Ask residents."
    },
    "prompt": {
      "type": "string",
      "description": "The user's words, verbatim. Kept for the record; NOT sent to residents."
    },
    "summary": {
      "type": "string",
      "maxLength": 240,
      "description": "One neutral, plain-English sentence describing the proposal, rebuilt from the constraint values. This is what residents are asked about."
    },
    "districts": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 7
      },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "unsupported": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Parts of the question no action covers (UI says 'not supported yet')."
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "type",
          "title",
          "constraints"
        ],
        "properties": {
          "action_id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "add_drone_route",
              "add_building",
              "modify_road",
              "change_transit",
              "rezone",
              "add_event_surge"
            ]
          },
          "title": {
            "type": "string"
          },
          "constraints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/constraint"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "constraint": {
      "type": "object",
      "required": [
        "id",
        "label",
        "type",
        "value",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Matches an id in contracts/actions.json for this action type."
        },
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "number",
            "select",
            "path",
            "parcels",
            "text"
          ]
        },
        "value": {
          "description": "Current value. number -> number; select -> one option value; path -> [[lon,lat],...]; parcels -> [parcel_id,...]."
        },
        "unit": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {},
              "label": {
                "type": "string"
              }
            }
          }
        },
        "ui": {
          "enum": [
            "stepper",
            "select",
            "segmented"
          ]
        },
        "show": {
          "enum": [
            "panel",
            "map",
            "hidden"
          ],
          "default": "panel"
        },
        "show_if": {
          "type": "object",
          "description": "Show this block only when another constraint has one of these values."
        },
        "source": {
          "enum": [
            "from_question",
            "assumed",
            "edited"
          ],
          "description": "from_question: taken from the user's words. assumed: a default the agent filled in (UI shows an 'assumed' tag). edited: changed by the user in the panel."
        },
        "note": {
          "type": "string",
          "description": "Optional one-line explanation shown under the block."
        }
      }
    }
  }
}
