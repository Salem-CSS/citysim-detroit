{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario_spec.schema.json",
  "title": "Scenario spec",
  "description": "What the chat agent produces from a typed proposal. The engines run this. The agent never writes numbers that the engines compute.",
  "type": "object",
  "required": [
    "spec_id",
    "prompt",
    "actions",
    "districts",
    "assumptions",
    "confidence",
    "summary"
  ],
  "properties": {
    "spec_id": {
      "type": "string"
    },
    "prompt": {
      "type": "string",
      "description": "The user's words, verbatim."
    },
    "summary": {
      "type": "string",
      "description": "One plain-English line for the confirmation card."
    },
    "districts": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 7
      },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "parent_spec_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Set when a follow-up edits an earlier spec."
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/add_building"
          },
          {
            "$ref": "#/$defs/modify_road"
          },
          {
            "$ref": "#/$defs/add_drone_route"
          },
          {
            "$ref": "#/$defs/change_transit"
          },
          {
            "$ref": "#/$defs/rezone"
          },
          {
            "$ref": "#/$defs/add_event_surge"
          }
        ]
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        }
      }
    },
    "use": {
      "type": "object",
      "required": [
        "use",
        "ite_code"
      ],
      "properties": {
        "use": {
          "type": "string"
        },
        "ite_code": {
          "type": "integer"
        },
        "units": {
          "type": "number",
          "minimum": 0
        },
        "sqft": {
          "type": "number",
          "minimum": 0
        },
        "seats": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "add_building": {
      "type": "object",
      "required": [
        "type",
        "site",
        "uses"
      ],
      "properties": {
        "type": {
          "const": "add_building"
        },
        "parcel_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "site": {
          "$ref": "#/$defs/point"
        },
        "floors": {
          "type": "integer",
          "minimum": 1
        },
        "uses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/use"
          }
        }
      }
    },
    "modify_road": {
      "type": "object",
      "required": [
        "type",
        "segment_ids",
        "change"
      ],
      "properties": {
        "type": {
          "const": "modify_road"
        },
        "segment_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "change": {
          "enum": [
            "remove_lanes",
            "add_lanes",
            "close",
            "bike_lane"
          ]
        },
        "lanes_delta": {
          "type": "integer"
        },
        "bike_shift_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "add_drone_route": {
      "type": "object",
      "required": [
        "type",
        "hub",
        "path",
        "flights_per_day"
      ],
      "properties": {
        "type": {
          "const": "add_drone_route"
        },
        "hub": {
          "$ref": "#/$defs/point"
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "minItems": 2
        },
        "flights_per_day": {
          "type": "number",
          "minimum": 0
        },
        "van_share_replaced": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.2
        },
        "packages_per_van_trip": {
          "type": "number",
          "minimum": 1
        },
        "altitude_ft": {
          "type": "number",
          "default": 200
        },
        "noise_band_ft": {
          "type": "number",
          "default": 500
        }
      }
    },
    "change_transit": {
      "type": "object",
      "required": [
        "type",
        "route_id",
        "trips_per_hour"
      ],
      "properties": {
        "type": {
          "const": "change_transit"
        },
        "route_id": {
          "type": "string"
        },
        "trips_per_hour": {
          "type": "number",
          "minimum": 0
        },
        "new_route": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          }
        }
      }
    },
    "rezone": {
      "type": "object",
      "required": [
        "type",
        "parcel_ids",
        "new_zone"
      ],
      "properties": {
        "type": {
          "const": "rezone"
        },
        "parcel_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "new_zone": {
          "type": "string"
        }
      }
    },
    "add_event_surge": {
      "type": "object",
      "required": [
        "type",
        "site",
        "seats",
        "events_per_year"
      ],
      "properties": {
        "type": {
          "const": "add_event_surge"
        },
        "site": {
          "$ref": "#/$defs/point"
        },
        "seats": {
          "type": "number",
          "minimum": 0
        },
        "events_per_year": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
