{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run_result.schema.json",
  "title": "Run result",
  "description": "Everything the frontend shows after a run. Residents answer only support / neutral / oppose plus one reason (and a quote for a ~10% sample). Percentages are 0-100. Load is volume/capacity; the UI shows it as '% full'.",
  "type": "object",
  "required": [
    "spec_id",
    "run_id",
    "status",
    "overall",
    "reasons",
    "districts",
    "segments",
    "run_stats"
  ],
  "properties": {
    "spec_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "running",
        "done",
        "failed"
      ]
    },
    "cached": {
      "type": "boolean",
      "default": false
    },
    "created_at": {
      "type": "string"
    },
    "overall": {
      "allOf": [
        {
          "type": "object",
          "required": [
            "support",
            "neutral",
            "oppose"
          ],
          "properties": {
            "support": {
              "type": "number"
            },
            "neutral": {
              "type": "number"
            },
            "oppose": {
              "type": "number"
            },
            "support_range": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      ],
      "description": "Census-weighted across all selected districts."
    },
    "groups": {
      "type": "array",
      "description": "Support by resident group (Who tab).",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "label",
          "support"
        ],
        "properties": {
          "dimension": {
            "enum": [
              "exposure",
              "tenure",
              "age",
              "vehicles"
            ]
          },
          "label": {
            "type": "string"
          },
          "support": {
            "type": "number"
          },
          "n": {
            "type": "integer"
          },
          "neutral": {
            "type": "number"
          },
          "oppose": {
            "type": "number"
          }
        }
      }
    },
    "districts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "district",
          "split",
          "top_reason"
        ],
        "properties": {
          "district": {
            "type": "integer"
          },
          "split": {
            "type": "object",
            "required": [
              "support",
              "neutral",
              "oppose"
            ],
            "properties": {
              "support": {
                "type": "number"
              },
              "neutral": {
                "type": "number"
              },
              "oppose": {
                "type": "number"
              },
              "support_range": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "n": {
            "type": "integer"
          },
          "top_reason": {
            "enum": [
              "traffic",
              "noise",
              "safety",
              "privacy",
              "rent",
              "jobs",
              "access",
              "none"
            ]
          },
          "groups": {
            "type": "array",
            "description": "Same groups as the top-level list, for this district only.",
            "items": {
              "type": "object",
              "required": [
                "dimension",
                "label",
                "support"
              ],
              "properties": {
                "dimension": {
                  "enum": [
                    "exposure",
                    "tenure",
                    "age",
                    "vehicles"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "support": {
                  "type": "number"
                },
                "n": {
                  "type": "integer"
                },
                "neutral": {
                  "type": "number"
                },
                "oppose": {
                  "type": "number"
                }
              }
            }
          },
          "profile": {
            "type": "object",
            "description": "Who this district's residents are (weighted %, census-derived).",
            "properties": {
              "residents": {
                "type": "integer"
              },
              "age": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "renters": {
                "type": "number"
              },
              "no_car": {
                "type": "number"
              },
              "median_income": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "persona_id",
          "text",
          "stance",
          "reason"
        ],
        "properties": {
          "persona_id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "maxLength": 200
          },
          "stance": {
            "enum": [
              "support",
              "neutral",
              "oppose"
            ]
          },
          "who": {
            "type": "string",
            "description": "e.g. 'Homeowner, 62, District 6'"
          },
          "district": {
            "type": "integer"
          },
          "reason": {
            "enum": [
              "traffic",
              "noise",
              "safety",
              "privacy",
              "rent",
              "jobs",
              "access",
              "none"
            ]
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "name",
          "aadt_before",
          "aadt_after",
          "load_before",
          "load_after"
        ],
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "counted": {
            "type": "boolean"
          },
          "aadt_before": {
            "type": "number"
          },
          "aadt_after": {
            "type": "number"
          },
          "lanes": {
            "type": "integer"
          },
          "load_before": {
            "type": "number"
          },
          "load_after": {
            "type": "number"
          }
        }
      }
    },
    "trips": {
      "type": "object",
      "properties": {
        "daily_raw": {
          "type": "number"
        },
        "daily_adjusted": {
          "type": "number"
        },
        "pm_peak": {
          "type": "number"
        }
      }
    },
    "blocks": {
      "type": "array",
      "description": "Per-block popover data.",
      "items": {
        "type": "object",
        "required": [
          "block_geoid"
        ],
        "properties": {
          "block_geoid": {
            "type": "string"
          },
          "support": {
            "type": "number"
          },
          "n": {
            "type": "integer"
          },
          "in_noise_band": {
            "type": "boolean"
          },
          "top_reason": {
            "enum": [
              "traffic",
              "noise",
              "safety",
              "privacy",
              "rent",
              "jobs",
              "access",
              "none"
            ]
          }
        }
      }
    },
    "calibration": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "real": {
                "type": "number"
              },
              "simulated": {
                "type": "number"
              },
              "error_pts": {
                "type": "number"
              }
            }
          }
        },
        "avg_error_pts": {
          "type": [
            "number",
            "null"
          ]
        },
        "measured": {
          "type": "boolean"
        }
      }
    },
    "run_stats": {
      "type": "object",
      "required": [
        "residents",
        "valid",
        "retried",
        "dropped",
        "drop_rate"
      ],
      "properties": {
        "residents": {
          "type": "integer"
        },
        "bedrock_calls": {
          "type": "integer"
        },
        "valid": {
          "type": "integer"
        },
        "retried": {
          "type": "integer"
        },
        "dropped": {
          "type": "integer"
        },
        "drop_rate": {
          "type": "number"
        },
        "unreliable": {
          "type": "boolean"
        },
        "seconds": {
          "type": "number"
        },
        "quotes_requested": {
          "type": "integer"
        }
      }
    },
    "reasons": {
      "type": "array",
      "description": "Share of all residents giving each reason (any stance), sorted desc.",
      "items": {
        "type": "object",
        "required": [
          "reason",
          "share"
        ],
        "properties": {
          "reason": {
            "enum": [
              "traffic",
              "noise",
              "safety",
              "privacy",
              "rent",
              "jobs",
              "access",
              "none"
            ]
          },
          "share": {
            "type": "number"
          },
          "share_among_oppose": {
            "type": "number",
            "description": "Share of opposing residents giving this reason."
          }
        }
      }
    },
    "spec_version": {
      "type": "integer"
    }
  }
}
